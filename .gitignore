# Local runtime credentials — never commit, at any depth.
# demo/keys/ ships the public demo fixtures at HEAD so fresh clones can run:
#   customer_private.pem — decrypts the encrypted demo images at runtime
#   license.token        — pre-issued demo licence (run-only, cannot mint)
# The vendor private key is the ONLY file that could mint new tokens and it
# is never committed anywhere.
.env
**/.env
!**/.env.example

# Never commit the vendor signing key (token-minting capability).
demo/keys/vendor_private.pem
