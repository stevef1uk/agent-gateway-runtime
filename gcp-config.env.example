# Copy this file to gcp-config.env and fill in your deployment values.
# The local gcp-config.env file is ignored by Git.
: "${GCP_PROJECT_ID:=}"
: "${GCP_REGION:=europe-west9}"
: "${GCP_DEPLOYMENT_ID:=agent-gateway-dev}"
: "${GCP_DOCKERHUB_NAMESPACE:=}"
: "${GCP_KEYS_DIRECTORY:=keys}"
: "${GCP_ADMIN_EMAILS:=}"
: "${GCP_OIDC_CLIENT_ID:=}"
: "${GCP_OIDC_CLIENT_SECRET_FILE:=}"
: "${GCP_EMOTION_TOKEN_FILE:=}"
