# Agent Gateway & FreeRide Demo Environment Configuration
# Copy this file to .env before starting the stack:
#   cp .env.example .env
#
# FreeRide AI Configuration Assistant (✨ AI Config Assistant in Web Console):
# Supply at least one valid provider API key below. FreeRide automatically proxies
# requests to your chosen provider via its OpenAI-compatible endpoint (:11434).

# Primary model and provider labels presented in the Console UI:
FREERIDE_MODEL=gpt-4o
FREERIDE_PROVIDER=FreeRide

# 1. OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# 2. Google Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 3. Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# 4. Cerebras (https://cloud.cerebras.ai/)
CEREBRAS_API_KEY=

# 5. NVIDIA NIM (https://build.nvidia.com/)
NVIDIA_API_KEY=

# 6. Cloudflare Workers AI (https://dash.cloudflare.com/)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 7. Ollama Cloud
OLLAMA_API_KEY=

# Optional Port Overrides:
GATEWAY_HOST_PORT=8080
GATEWAY_MCP_HOST_PORT=8085
FREERIDE_HOST_PORT=11435

# Human-in-the-loop Telegram Approvals (optional):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APPROVAL_CONSOLE_URL=http://localhost:8083
