# Agent Gateway & FreeRide Demo Environment Configuration
# Run ensure-secrets.sh before starting the stack. It creates this ignored
# file when absent and fills missing JWT/admin secrets with independent values.
#
# FreeRide AI Configuration Assistant (✨ AI Config Assistant in Web Console):
# Supply at least one valid provider API key below. FreeRide automatically proxies
# requests to your chosen provider via its OpenAI-compatible endpoint (:11434).

# Primary model and provider labels presented in the Console UI:
FREERIDE_MODEL=gpt-4o
FREERIDE_PROVIDER=FreeRide

# Optional Compose image overrides. Defaults use the signed, digest-pinned main
# images below. Set these to local security-test tags only when deliberately
# testing locally built product images.
AUTHZ_IMAGE=docker.io/stevef1uk/agent-gateway-authz:1.0.16@sha256:a0ce26b4f5fabae96e084d15b9777c4a730c6e530c1c4e5393e7ea170b22357f
TOKENSVC_IMAGE=docker.io/stevef1uk/agent-gateway-tokensvc:1.0.10@sha256:e62ede0ee3a8308ccc5a060d95b9b2159f34b653b56514f3102833a8b5faff1c
GATEWAY_IMAGE=docker.io/stevef1uk/agent-gateway-gateway:1.0.36@sha256:2dce006ce0b53bdeb57525b3d993809fbc802a24e1dcfd39e46dde1a4ee72ce8
WEB_IMAGE=docker.io/stevef1uk/agent-gateway-web:1.0.61@sha256:12c13a7240547ed43b7cd84c37d24b751d29a0b1eef5f3fb0095acd3b9f0cc4d

# Authz, TokenSvc, and every gateway share JWT_SECRET: Authz issues the
# delegation bearer tokens that those gateways validate. GATEWAY_ADMIN_TOKEN
# is a separate operator credential. Keep both only in demo/.env.
JWT_SECRET=
GATEWAY_ADMIN_TOKEN=

# OIDC console settings for hardened mode. The normal local-demo Compose
# command defaults WEB_ADMIN_EMAILS to the documented Alice fixture; the
# hardened overlay requires you to set this to your real verified IdP email.
# Set OIDC_CONNECTOR_ID to google or microsoft. The setup script reads these
# credentials and writes them into the ignored demo/dex/config.hardened.yaml.
# For Microsoft, Dex uses tenant=common.
# Set WEB_ADMIN_EMAILS to exact, verified provider email(s), comma-separated.
# Keep real credentials only in this ignored file, never in Compose or tracked
# configs.
# configure-idp.py sets DEX_UID/DEX_GID to the current host user so the Dex
# container can read its generated mode-0600 config without making it public.
# For an external IdP, use the same HTTPS tunnel issuer and its /callback URL;
# see docs/Deployment-Guide.md#local-google-idp-test.
WEB_PUBLIC_URL=http://localhost:8083
OAUTH_PUBLIC_BASE=
OAUTH_PUBLIC_BASE_EMOTION=
WEB_ADMIN_EMAILS=
OIDC_CONNECTOR_ID=
DEX_UPSTREAM_CLIENT_ID=
DEX_UPSTREAM_CLIENT_SECRET=
DEX_ISSUER_URL=
DEX_UPSTREAM_REDIRECT_URI=

# 1. OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# 2. Google Gemini API (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# 3. Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# 4. Cerebras (https://cloud.cerebras.ai/)
CEREBRAS_API_KEY=

# 5. NVIDIA NIM (https://build.nvidia.com/)
NVIDIA_API_KEY=

# 6. Cloudflare Workers AI (https://dash.cloudflare.com/)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# 7. Ollama Cloud
OLLAMA_API_KEY=

# Optional Port Overrides:
GATEWAY_HOST_PORT=8080
GATEWAY_MCP_HOST_PORT=8085
FREERIDE_HOST_PORT=11435

# Human-in-the-loop Telegram Approvals (optional):
# New approval lifetime (Go duration); normal default is 15m. The gateway image
# must implement APPROVAL_TTL for this setting to take effect; the local
# security-test image in this checkout currently ignores it.
APPROVAL_TTL=15m
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
APPROVAL_CONSOLE_URL=http://localhost:8083
